# SQLite databases
*.db
*.db-shm
*.db-wal

# Python cache
__pycache__/
*.pyc
*.pyo

# Photo carousel (large binary files — store separately)
photos/

# Secrets / local overrides
.env
*.secret
k8s.local.yml
agent/truenas-compose.local.yml

# Live k3s client cert + EC private key. This repo is PUBLIC -- these grant
# access to the cluster and must never be committed. Argus reads them from
# the path in config.json "key"; keep them out of git entirely.
argus/secrets/
*.key
*.crt
*.pem

# Argus runtime state (rewritten on every poll)
argus/data/

# Build artifacts / binaries (too big for git, baked into the container instead)
agent/dist/
agent/*.tar
agent_dist/
Fleet/.build/
squashfs-root/
*.tar.gz

# Old code kept for reference
app.py.sqlite-bak

# Claude session files
RESUME_CONTEXT.md

# Editor / OS
.DS_Store
*.swp
*.swo
FLEET.local.md
